# Copy to .env.local and fill in. NEVER commit real keys — .gitignore covers
# .env* and allows only this example file through.

# Shared Supabase blog CMS (the /explore-cascade posts). Same project values as
# the other Arrowleaf client sites.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# --- Private review feedback (/leave-a-review) ----------------------------
# Until RESEND_API_KEY + RESEND_FROM + REVIEW_FEEDBACK_TO are all set, guest
# feedback is logged to the server console and DISCARDED. See
# docs/leave-a-review-setup.md for the full walkthrough.

# Resend API key ("re_..."), from https://resend.com/api-keys
RESEND_API_KEY=

# Sender address — MUST be on a domain verified in Resend, e.g. "Birch Glen Lodge <feedback@thebirchglenlodge.com>"
RESEND_FROM=

# Inbox that receives private guest feedback. Deliberately separate from any
# general contact-form recipient so complaints never enter the new-lead flow.
REVIEW_FEEDBACK_TO=

# Optional CRM/automation webhook posted alongside the email (leave blank to skip)
REVIEW_FEEDBACK_WEBHOOK_URL=
